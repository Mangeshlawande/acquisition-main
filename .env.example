# Local development environment template.
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (Neon connection string)
DATABASE_URL=postgresql://user:password@your-neon-endpoint.neon.tech/neondb?sslmode=require

# JWT Configuration (use a long random string)
JWT_SECRET=change_me_to_a_long_random_secret

# Arcjet Configuration
ARCJET_ENV=development
ARCJET_KEY=your_arcjet_key_here
