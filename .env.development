# Development Environment Configuration
# This file is used when running the application locally with Docker Compose

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Neon Local Configuration
# Replace these with your actual Neon project details
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
PARENT_BRANCH_ID=your_parent_branch_id_here

# Database Configuration for Development
# This connects to the Neon Local proxy which creates ephemeral branches
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb?sslmode=require

# JWT Configuration
JWT_SECRET=your_development_jwt_secret_here

# Arcjet Configuration for Development
ARCJET_ENV=development
ARCJET_KEY=your_arcjet_key_here